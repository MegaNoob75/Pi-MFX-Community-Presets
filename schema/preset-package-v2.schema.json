{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MegaNoob75/Pi-MFX-Community-Presets/blob/main/schema/preset-package-v2.schema.json",
  "title": "Pi-MFX Community Preset Package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "author",
    "description",
    "tags",
    "license",
    "compatibility",
    "preset",
    "dependencies",
    "checksums"
  ],
  "properties": {
    "format": {
      "const": "pimfx-community-preset"
    },
    "formatVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 +._-]{0,31}$"
      }
    },
    "license": {
      "const": "MIT"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumPiMfxVersion"
      ],
      "properties": {
        "minimumPiMfxVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "maximumPiMfxVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "architectures": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "aarch64",
              "armv7",
              "x86_64"
            ]
          }
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tempo",
        "inputGainDb",
        "outputGainDb",
        "chain",
        "snapshots",
        "parameterBindings"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "maxLength": 80
        },
        "tempo": {
          "type": "number",
          "minimum": 30,
          "maximum": 300
        },
        "inputGainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 24
        },
        "outputGainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 24
        },
        "chain": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "uri",
              "name",
              "enabled",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,80}$"
              },
              "uri": {
                "type": "string",
                "pattern": "^(urn:|https?://)\\S+$",
                "maxLength": 300
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "enabled": {
                "type": "boolean"
              },
              "state": {
                "type": "object"
              },
              "tempoLinks": {
                "type": "object"
              }
            }
          }
        },
        "snapshots": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object"
          }
        },
        "parameterBindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effects",
        "tone3000",
        "irs",
        "localAssets"
      ],
      "properties": {
        "effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "maxLength": 300
              },
              "catalogId": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        },
        "tone3000": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toneId",
              "modelId",
              "expectedFilename",
              "sha256"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "architecture": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "expectedFilename": {
                "type": "string",
                "pattern": "^[^/\\\\]{1,180}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "kind": {
                "enum": [
                  "model",
                  "ir",
                  "aidax"
                ]
              },
              "toneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "toneTitle": {
                "type": "string",
                "maxLength": 200
              },
              "creator": {
                "type": "string",
                "maxLength": 120
              },
              "sourceLicense": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        },
        "irs": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "sourceId",
              "expectedFilename",
              "sha256"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "expectedFilename": {
                "type": "string",
                "pattern": "^[^/\\\\]{1,180}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "localAssets": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "expectedFilename",
              "sha256"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "model",
                  "ir",
                  "aidax"
                ]
              },
              "expectedFilename": {
                "type": "string",
                "pattern": "^[^/\\\\]{1,180}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "previews": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "filename",
          "mediaType",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "image",
              "audio"
            ]
          },
          "filename": {
            "type": "string",
            "pattern": "^preview\\.(webp|ogg)$"
          },
          "mediaType": {
            "enum": [
              "image/webp",
              "audio/ogg"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "checksums": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]{1,180}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
